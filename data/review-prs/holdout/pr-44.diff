+from __future__ import annotations
+
+from appointment_reminders.app.api.web import app, rate_limit
+from appointment_reminders.tools.quota import remaining_quota
+
+
+@app.route("/api/quota")
+@rate_limit()
+def quota_view(store, branch: str) -> dict:
