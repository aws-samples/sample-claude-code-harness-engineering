PR #341: Requeue batches when a worker is recycled
Description: Batches die when a worker is recycled mid-run. Put them back on the queue.

diff --git a/appointment_reminders/service/worker.py b/appointment_reminders/service/worker.py
index 994c6b8..13a3889 100644
--- a/appointment_reminders/service/worker.py
+++ b/appointment_reminders/service/worker.py
@@ -21,4 +21,5 @@ async def run_batch(batch, gateway, send_log, queue) -> None:
             await gateway.send_message(reminder)
         await send_log.record_sent(batch.id, batch.size)
     except WorkerRecycled:
-        logger.info("worker recycled during batch %s", batch.id)
+        logger.info("worker recycled, requeuing batch %s", batch.id)
+        await queue.put(batch)
