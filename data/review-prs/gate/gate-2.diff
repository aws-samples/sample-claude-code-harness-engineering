diff --git a/appointment_reminders/tests/test_opening_hours.py b/appointment_reminders/tests/test_opening_hours.py
new file mode 100644
index 0000000..e9a3f14
--- /dev/null
+++ b/appointment_reminders/tests/test_opening_hours.py
@@ -0,0 +1,18 @@
+from __future__ import annotations
+
+from datetime import datetime
+
+from appointment_reminders.service.opening_hours import hours_line, hours_on
+
+MONDAY = datetime(2030, 3, 4, 9)
+SATURDAY = datetime(2030, 3, 9, 9)
+
+
+def test_weekday_hours():
+    assert hours_line("US-1", MONDAY) == "Monday: 08:30 to 18:00"
+
+
+def test_some_branches_close_on_saturday():
+    assert hours_on("US-2", SATURDAY) is None
+    assert hours_line("US-2", SATURDAY) == "Saturday: closed"
+    assert hours_line("US-1", SATURDAY) == "Saturday: 09:00 to 13:00"
