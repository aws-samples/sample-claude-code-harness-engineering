PR #362: Short reminder wording for the status page
Description: The branch status page needs a short version of the reminder wording. Reminders themselves keep the long one. Marketing has mentioned hiding the region and adding a sign-off, so this puts the wording choices in one place.

diff --git a/appointment_reminders/service/risk.py b/appointment_reminders/service/risk.py
index 609cafc..18741e0 100644
--- a/appointment_reminders/service/risk.py
+++ b/appointment_reminders/service/risk.py
@@ -1,6 +1,8 @@
 """Late-cancellation risk."""
 from __future__ import annotations
 
+from dataclasses import dataclass
+
 
 def late_cancel_score(distance_risk: float, history_risk: float) -> float:
     return round(distance_risk + history_risk, 6)
@@ -13,6 +15,17 @@ def get_region(code: str) -> str:
     return REGIONS[code]
 
 
-def reminder_text(branch: str) -> str:
-    """The reminder for a branch such as US-1."""
-    return f"You have an appointment at your {branch} branch in {get_region(branch.split('-')[0])}."
+@dataclass(frozen=True)
+class ReminderStyle:
+    short: bool = False
+    show_region: bool = True
+    sign_off: str = ""
+
+
+def reminder_text(branch: str, style: ReminderStyle = ReminderStyle()) -> str:
+    """The reminder for a branch such as US-1, in the given style."""
+    where = f"your {branch} branch"
+    if style.show_region:
+        where += f" in {get_region(branch.split('-')[0])}"
+    text = f"Appointment at {where}." if style.short else f"You have an appointment at {where}."
+    return f"{text} {style.sign_off}" if style.sign_off else text
diff --git a/appointment_reminders/service/status_page.py b/appointment_reminders/service/status_page.py
