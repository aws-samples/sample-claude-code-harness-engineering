+"""Settings for the SMS provider."""
+from __future__ import annotations
+
+import os
+
+
+def provider_api_key() -> str:
+    """The SMS provider's key, from the environment.
+
+    Failure modes: raises KeyError if SMS_PROVIDER_API_KEY isn't set.
+    """
+    return os.environ["SMS_PROVIDER_API_KEY"]
