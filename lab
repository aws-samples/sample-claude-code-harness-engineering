CATCH_UP = {
    "checks": ("after-checks", ["scripts/checks.py", ".githooks/pre-commit"], "Run ./lab test-checks to see them work, then ./lab next."),
    "reviewer": ("after-reviewer", ["my-work/3-reviewer-agent.md"], "Try it with ./lab review try, then ./lab next."),
    "scorer": ("after-scorer", ["scripts/score.py"], "Read it, run ./lab test-scorer, then ./lab next."),
