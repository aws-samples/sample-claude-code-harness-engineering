    "gate": ("after-gate", ["scripts/gate.py", "my-work/6-gate-agent.md"], "Now run ./lab pipeline, then ./lab loop pr-03."),
}
HELP = """Move through the lab
  ./lab                    where you are, and what's left
  ./lab next               the next chunk
  ./lab goto CHUNK         jump to any chunk: {chunks}
  ./lab catch-up CHUNK     take our working version: checks, reviewer, scorer, improve, gate
