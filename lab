def current() -> str:
    stage = STAGE.read_text().strip() if STAGE.exists() else ""
    return stage if stage in CHUNKS else ""


def files_of(chunk: str) -> list[Path]:
    return [Path(word) for word in CHUNKS[chunk]["file"].split() if word.startswith("my-work/")]


def show(chunk: str) -> None:
    spec = CHUNKS[chunk]
    print(f"\n{spec['label']}\n")
    print(f"  Your file:  {spec['file']}")
    for path in files_of(chunk):
        left = todos_left(path)
        if left:
            print(f"              {left} TODO{'s' if left != 1 else ''} left in {path.name}")
    print(f"  Do this:    {spec['todo']}")
    print(f"  Done when:  {spec['done']}\n")


def unseal(paths: list[str]) -> bool:
    """The labels, the holdout and the gate PRs wait in the sealed tag until they're needed. Restored, not staged,
    so that the person's next commit doesn't sweep them in."""
    missing = [path for path in paths if not Path(path).exists()]
    if not missing:
        return True
    if subprocess.run(["git", "restore", "--source=sealed", "--worktree", "--", *missing], capture_output=True).returncode == 0:
        exclude = Path(".git/info/exclude")  # git's own local ignore list, so that no `git add -A` commits them
        if exclude.parent.is_dir():
            known = exclude.read_text().splitlines() if exclude.exists() else []
            with exclude.open("a") as out:
                out.writelines(f"/{path}\n" for path in missing if f"/{path}" not in known)
        print(f"Opened: {', '.join(missing)}")
        return True
    print(f"Couldn't open {', '.join(missing)}: the repo is missing its git tags. Ask a helper.")
    return False


def go(chunk: str) -> None:
    previous = current()
    if previous:
        left = sum(todos_left(path) for path in files_of(previous))
        if left and chunk != previous:
            print(f"{left} TODO{'s' if left != 1 else ''} left in {previous}. You can come back to {'them' if left != 1 else 'it'}.")
    unseal(OPENS.get(chunk, []))
    STAGE.write_text(chunk + "\n")
    with LOG.open("a") as log:
        log.write(f"{time.time():.0f}\t{chunk}\n")
    show(chunk)


def run(script: str, *args: str) -> int:
    """Run one of the lab's scripts in this process, as if from the command line, and return its exit code.

    No new process starts, so no command line is built from what you type."""
    saved_argv, saved_path = sys.argv, sys.path[:]
    sys.argv = [script, *args]
    try:
        runpy.run_path(script, run_name="__main__")
        return 0
    except SystemExit as done:
        if done.code is None or isinstance(done.code, int):
            return done.code or 0
        print(done.code, file=sys.stderr)
        return 1
    finally:
        sys.argv, sys.path[:] = saved_argv, saved_path


def written(agent: Path) -> bool:
    return agent.exists() and STARTER not in agent.read_text()


def scorer_problem() -> str:
    from eval_reviewer import scorer_problem as problem
    return problem()


def option(args: list[str], name: str) -> tuple[str, list[str]]:
    """The value after --name, and the other arguments."""
    if name in args[:-1]:
        at = args.index(name)
        return args[at + 1], args[:at] + args[at + 2:]
    return "", args


def review(args: list[str]) -> int:
    if not args or args[0] not in {"try", "dev", "design", "holdout"}:
        sys.exit("usage: ./lab review try|dev|design [--agent FILE] [--out FILE]. Your reviewer is my-work/3-reviewer-agent.md.")
    which, extra = args[0], args[1:]
    if which == "holdout" and "--out" not in extra:
        sys.exit("To run the holdout: ./lab holdout. To try another reviewer on it: ./lab review holdout --agent FILE --out FILE")
    command = {
        "try": ["--set", "try", "--out", "results-try.json"],
        "dev": ["--set", "dev", "--out", "results.json"],
        "design": ["--set", "design", "--runs", "3", "--out", "results-design.json"],
        "holdout": ["--set", "holdout"],
    }[which]
    return run("scripts/run_reviewer.py", *command, *extra)


def fingerprint(agent: Path, model: str) -> str:
    return hashlib.sha256(agent.read_bytes() + model.encode()).hexdigest()


def evaluate(args: list[str]) -> int:
    """./lab eval: run the reviewer on the dev PRs and score it, marking what changed since the last run."""
    if any(arg in ("--runs", "--out") for arg in args):
        sys.exit("Run ./lab eval twice instead: it shows what changed.")
    note, args = option(args, "--note")
    agent, args = option(args, "--agent")
    if args:
        sys.exit("usage: ./lab eval [--note \"what you changed\"] [--agent FILE]")
    if not Path(LABELS).exists():
        sys.exit("The lead's labels aren't open yet: ./lab goto scorer")
    if scorer_problem():
        sys.exit(scorer_problem())
    import run_reviewer as runner
    reviewer = Path(agent) if agent else AGENT
    if not written(reviewer):
        sys.exit(f"{reviewer} isn't written yet. In Claude, run /interview-reviewer, or take ours with ./lab catch-up reviewer.")
    try:
        previous = json.loads(LAST_EVAL.read_text()).get("fingerprint", "")
    except (OSError, ValueError):
        previous = ""
    had_results = Path("results.json").exists()
    if had_results:
        shutil.copy("results.json", "results-prev.json")
    done = review(["dev", "--quiet", *(["--agent", agent] if agent else [])])
    if done:
        return done
    LAST_EVAL.write_text(json.dumps({"fingerprint": fingerprint(reviewer, runner.MODEL), "previous": previous if had_results else ""}))
    extra = ["--compare", "results-prev.json"] if had_results else []
    extra += ["--note", note] if note else []
    extra += ["--agent", agent] if agent else []
    return run("scripts/eval_reviewer.py", "--record", "--model", runner.MODEL, "--tools", runner.agent_tools(reviewer), *extra)


def holdout() -> int:
    """./lab holdout: freeze the reviewer and run it once on the holdout. Running it again shows the same result."""
    if not written(AGENT):
        sys.exit("Your reviewer isn't written yet. In Claude, run /interview-reviewer, or ./lab catch-up reviewer.")
    if scorer_problem():
        sys.exit(scorer_problem())
    import run_reviewer as runner
    saved = Path("results-holdout.json")
    score = ["--set", "holdout", "--results", str(saved)]
    if not saved.exists() or not FROZEN.exists():
        if not unseal([HOLDOUT, LABELS]):
            return 1
        shutil.copy(AGENT, FROZEN)
        print("Your reviewer is frozen: the holdout runs on a copy made now.")
        done = run("scripts/run_reviewer.py", "--set", "holdout", "--out", str(saved), "--quiet")
        if done:
            return done
        return run("scripts/eval_reviewer.py", *score, "--record", "--model", runner.MODEL, "--tools", runner.agent_tools(FROZEN))
    failed = [name for name, answer in json.loads(saved.read_text()).items() if isinstance(answer, dict) and answer.get("verdict") is None]
    if failed:
        print(f"Running the {len(failed)} holdout PRs that failed last time again, with your frozen reviewer.")
        done = run("scripts/run_reviewer.py", "--set", "holdout", "--out", str(saved), "--only", ",".join(failed), "--quiet")
        if done:
            return done
    else:
        print(f"You've already run the holdout, with your reviewer as it was at {time.strftime('%H:%M', time.localtime(FROZEN.stat().st_mtime))}. Here's that result.\n")
    return run("scripts/eval_reviewer.py", *score)


def serve(cwd: str, options: list) -> int:
    """Run the app's server in cwd, with the workshop's packages."""
    try:
        if shutil.which("uv"):
            return subprocess.run(["uv", "run", "--quiet", "--project", str(Path.cwd()), "python", "-m", "appointment_reminders.app.server", *options], cwd=cwd).returncode
        return subprocess.run(["python3", "-m", "appointment_reminders.app.server", *options], cwd=cwd).returncode
    except KeyboardInterrupt:
        return 0


def demo(args: list) -> int:
    """Run the app, with one PR's change applied if you name one, so you can see what it does."""
    options = []
    for name in ("--port", "--trouble"):  # passed on to the server
        value, args = option(args, name)
        options += [name, value] if value else []
    if not args:
        return serve(".", options)
    pr = args[0]
    diffs = sorted(Path("data/review-prs").glob(f"*/{pr}.diff"))
    if not diffs:
        sys.exit(f"There's no open PR called {pr}. The holdout and gate PRs open later.")
    copy = Path(tempfile.mkdtemp(prefix=f"demo-{pr}-"))
    shutil.copytree("appointment_reminders", copy / "appointment_reminders", ignore=shutil.ignore_patterns("__pycache__"))
    (copy / "pr.diff").write_text(diffs[0].read_text().partition("\n\n")[2])
    if subprocess.run(["git", "apply", "pr.diff"], cwd=copy).returncode:
        sys.exit(f"Couldn't apply {pr} to the app.")
    print(f"The app, with {pr} applied: {diffs[0].read_text().splitlines()[0]}")
    try:
        return serve(str(copy), options)
    finally:
        shutil.rmtree(copy, ignore_errors=True)


def backup(path: Path) -> Path:
    """The next free .orig, .orig2, ... beside the file, so a second catch-up never overwrites the first backup."""
    number = 1
    while True:
        candidate = Path(f"{path}.orig{number if number > 1 else ''}")
        if not candidate.exists():
            return candidate
        number += 1


def add_ask_human(path: Path) -> None:
    """Gives the reviewer the H4 line, before its closing JSON instructions, if it doesn't have it."""
    text = path.read_text()
    if "ask_human" in text:
        return
    saved = backup(path)
    shutil.copy(path, saved)
    lines = text.splitlines()
    at = max((i for i, line in enumerate(lines) if line.startswith("End every reply")), default=len(lines))
    lines[at:at] = [ASK_HUMAN, ""] if at < len(lines) else ["", ASK_HUMAN]
    path.write_text("\n".join(lines) + "\n")
    print(f"Added the ask_human line to {path}, for H4. Yours is saved as {saved.name}.")


def catch_up(chunk: str) -> int:
    if chunk not in CATCH_UP:
        sys.exit(f"usage: ./lab catch-up {'|'.join(CATCH_UP)}")
    tag, paths, then = CATCH_UP[chunk]
    saved = []
    for path in map(Path, paths):
        if path.exists():
            target = backup(path)
            shutil.copy(path, target)
            saved.append(target.name)
    code = subprocess.run(["git", "restore", f"--source={tag}", "--worktree", "--", *paths]).returncode
    if code:
        return code
    if chunk == "checks":
        subprocess.run(["git", "config", "core.hooksPath", ".githooks"], check=True)
    print(f"Replaced with our working version: {', '.join(paths)}.{' Yours are saved as ' + ', '.join(saved) + '.' if saved else ''}")
    if chunk == "gate":
        add_ask_human(AGENT)
    print(then)
    return 0


def doctor() -> int:
    """Checks this machine has what the lab needs, with the fix for anything missing."""
    import run_reviewer as runner
    failures = 0

    def report(ok: bool, what: str, fix: str = "") -> None:
        nonlocal failures
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'} {what}{'' if ok else '. ' + fix}")

    report(sys.version_info >= (3, 9), f"Python {sys.version.split()[0]}", "Install Python 3.9 or newer.")
    git = re.search(r"(\d+)\.(\d+)", subprocess.run(["git", "--version"], capture_output=True, text=True).stdout)
    report(bool(git) and (int(git.group(1)), int(git.group(2))) >= (2, 23), f"git {git.group(0) if git else 'not found'}", "Install git 2.23 or newer.")
    report(shutil.which("uv") is not None, "uv", "Install uv: https://docs.astral.sh/uv/")
    report(shutil.which("claude") is not None, "claude", "Install Claude Code, and check it's on your PATH.")
    tags = subprocess.run(["git", "tag"], capture_output=True, text=True).stdout.split()
    missing = [tag for tag in TAGS if tag not in tags]
    report(not missing, "git tags", f"Missing {', '.join(missing)}. This copy wasn't made with setup.sh: ask a helper.")
    if shutil.which("uv"):
        done = subprocess.run(["uv", "run", "--quiet", "python", "-c", "import httpx"], capture_output=True, text=True)
        report(done.returncode == 0, "the workshop's packages", (done.stderr.strip().splitlines() or [""])[-1])
    env, auth = runner.settings_env(), runner.settings_auth()
    print(f"     sign-in: {'Bedrock, ' + env.get('AWS_REGION', 'no region') if env.get('CLAUDE_CODE_USE_BEDROCK') == '1' else 'the Claude API'}"
          f"{', with ' + ', '.join(auth) if auth else ''}")
    if shutil.which("claude"):
        with tempfile.TemporaryDirectory() as empty:
            for model in ("haiku", "sonnet", "opus"):
                reply = runner.run_claude("Reply with the word OK.", "Reply with the word OK and nothing else.", "", empty, model)
                report("error" not in reply and bool(reply.get("result")), f"a call to {model}", str(reply.get("error", "no reply"))[:200])
    print("Ready." if not failures else f"{failures} to fix.")
    return 1 if failures else 0


def main(args: list[str]) -> int:
    command = args[0] if args else "status"
    rest = args[1:]
    if command == "status":
        if current():
            show(current())
        else:
            print("\nNo chunk running. Start with ./lab next\n")
        print("./lab help lists every command.")
    elif command == "help":
        print(HELP.format(chunks=" ".join(ORDER)))
    elif command == "next":
        now = current()
        if now == ORDER[-1]:
            print("This is the last chunk.")
            return 0
        if now == "improve" and not Path("results-holdout.json").exists():
            print("Run ./lab holdout first. To skip it: ./lab goto gate")
            return 1
        go(ORDER[ORDER.index(now) + 1] if now else ORDER[0])
    elif command == "goto" and rest and rest[0] in CHUNKS:
        go(rest[0])
    elif command == "catch-up" and rest:
        return catch_up(rest[0])
    elif command == "doctor":
        return doctor()
    elif command == "test-checks":
        return run("scripts/test_checks.py")
    elif command == "test-scorer":
        return run("scripts/test_scorer.py")
    elif command == "test-gate":
        return run("scripts/test_gate.py") if unseal([GATE]) else 1
    elif command == "review":
        return review(rest)
    elif command == "eval":
        return evaluate(rest)
    elif command == "holdout":
        return holdout()
    elif command == "score":
        which = ["--set", "holdout", "--results", "results-holdout.json"] if rest[:1] == ["holdout"] else [*rest]
        return run("scripts/eval_reviewer.py", *which)
    elif command == "demo":
        return demo(rest)
    elif command == "pipeline":
        if rest:
            sys.exit("usage: ./lab pipeline. It runs the dev PRs and the gate PRs.")
        return run("scripts/review_pipeline.py") if unseal([LABELS, GATE]) else 1
    elif command == "loop":
        if not rest:
            sys.exit("usage: ./lab loop PR, such as ./lab loop pr-03")
        return run("scripts/loop.py", rest[0]) if unseal([LABELS, GATE]) else 1
    else:
        print(HELP.format(chunks=" ".join(ORDER)))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
